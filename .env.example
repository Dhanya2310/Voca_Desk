# VocaDesk Environment Configuration
# Copy this file to .env and fill in your API key(s).
# At least one key is needed to enable AI mode.
# The app works fully without AI mode configured.

# --- Google Gemini (free tier available) ---
# Get your key at: https://aistudio.google.com/apikey
VOCADESK_GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI (ChatGPT) ---
# Get your key at: https://platform.openai.com/api-keys
VOCADESK_OPENAI_API_KEY=your_openai_api_key_here
